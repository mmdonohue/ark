# Required — the shared Supabase project ARK's db/storage adapters point
# at (see services/supabase.js, adapters/postgres.js, adapters/storage.js).
# The local CLI (cli/ark.js) does NOT need these for its default SQLite
# vessel mode — only for anything that touches the cloud project (sync,
# chat import, ark-dev, migrate-media-to-storage, register-pipeline).
SUPABASE_URL=
SUPABASE_KEY=

# Optional — adapters/llm.js (OpenRouter-backed LLM service), only needed
# for pipelines/actions that call the llm service (e.g. pipelines/classify).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=

# Optional — cli/ark-dev.js's hardcoded identity for tracking ARK's own
# dev history against the shared cloud project. Irrelevant to a fresh,
# unrelated ARK instance.
ARK_CLOUD_ACTOR_ID=
ARK_CLOUD_USER_ID=
ARK_DEFAULT_STORE_ID=

# Optional — scene-detection pipeline (pipelines/youtube-scenes).
SCENEDETECT_BIN=

# Optional — used by at least one pipeline/action for building absolute
# URLs to rendered output.
RENDER_BASE_URL=
