# Cloud only — the shared Supabase project (services/supabase.js). The
# local CLI and tests run on SQLite without these; they're read lazily by
# anything that touches the cloud project (ark publish / sync.push, chat
# import, ark-dev, migrate-media-to-storage, register-pipeline).
SUPABASE_URL=
SUPABASE_KEY=

# Optional — adapters/llm.js (OpenRouter-backed LLM service), only needed
# for pipelines/actions that call the llm service (e.g. pipelines/classify).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=

# Optional — cli/ark-dev.js's hardcoded identity for tracking ARK's own
# dev history against the shared cloud project. Irrelevant to a fresh,
# unrelated ARK instance.
ARK_CLOUD_ACTOR_ID=
ARK_CLOUD_USER_ID=
ARK_DEFAULT_STORE_ID=

# Optional — scene-detection pipeline (pipelines/youtube-scenes).
SCENEDETECT_BIN=

# Optional — used by at least one pipeline/action for building absolute
# URLs to rendered output.
RENDER_BASE_URL=
